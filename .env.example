# Server
PORT=4173
# Leave HOST unset for local npm start. Docker Compose sets HOST=0.0.0.0 and requires auth for backend APIs.
NDR_DATA_DIR=.ndr-data
NDR_API_KEY=
NDR_ALLOW_LOCAL_DEV_ADMIN=false
NDR_ALLOW_DIRECT_INGEST=false
NDR_PRODUCTION_HARDENING=false
NDR_SESSION_SECRET=
NDR_SESSION_TTL_SECONDS=28800
NDR_OIDC_SESSION_TTL_SECONDS=900
NDR_SESSION_COOKIE_SECURE=false
NDR_SESSION_REGISTRY_REQUIRED=true
NDR_EVIDENCE_ATTESTATION_SECRET=
NDR_EVIDENCE_ATTESTATION_KEY_ID=signalprism-evidence-v1
NDR_MAX_BODY_BYTES=1048576
NDR_MAX_AWS_RESPONSE_BYTES=10485760
NDR_MAX_INGEST_TEXT_BYTES=5242880
NDR_AWS_REQUEST_TIMEOUT_MS=15000
NDR_OIDC_REQUEST_TIMEOUT_MS=10000
NDR_RATE_LIMIT_WINDOW_MS=60000
NDR_RATE_LIMIT_MAX=120
NDR_RATE_LIMIT_MAX_IDENTITIES=10000
NDR_DISTRIBUTED_RATE_LIMIT=false
NDR_TRUST_PROXY=false
NDR_RETAIN_RUNS=50
NDR_MAX_JOBS_PER_TENANT=50
NDR_MAX_ACTIVE_RUNS_PER_TENANT=3
NDR_ACTIVE_RUN_SLOT_TTL_SECONDS=3600
NDR_MIN_JOB_INTERVAL_MINUTES=5
NDR_MAX_JOB_INTERVAL_MINUTES=10080
NDR_EXPORT_APPROVAL_TTL_SECONDS=900
NDR_MAX_PENDING_EXPORT_APPROVALS=100
NDR_MAX_EXPORT_APPROVAL_BYTES=262144
NDR_EXPORT_PAYLOAD_BUCKET=
NDR_EXPORT_PAYLOAD_PREFIX=signalprism/export-approvals
NDR_EXPORT_PAYLOAD_REGION=us-east-1
NDR_REQUIRE_SEPARATE_APPROVER=true
NDR_STEP_UP_REQUIRED=false
NDR_STEP_UP_MAX_AGE_SECONDS=900
NDR_PROCESS_ROLE=all
# Production uses the Terraform-provisioned SQS URL and separate api/worker process roles.
NDR_QUEUE_URL=
NDR_QUEUE_ARN=
NDR_QUEUE_REGION=us-east-1
NDR_QUEUE_POLL_SECONDS=10
NDR_QUEUE_VISIBILITY_SECONDS=900
NDR_REQUIRE_DURABLE_QUEUE=false
NDR_SCHEDULER_MODE=local
NDR_SCHEDULER_ROLE_ARN=
NDR_RESPONSE_EVENT_BUS=
NDR_RESPONSE_EXECUTION_ENABLED=false
NDR_RESPONSE_VERIFIER_SUBJECTS=
# Base64-encoded Ed25519 public key in PEM or SPKI DER form. Never configure a private key here.
NDR_DETECTION_CONTENT_PUBLIC_KEY_B64=
NDR_AUDIT_RETENTION_DAYS=2555
NDR_AUDIT_BUCKET=
NDR_AUDIT_PREFIX=signalprism/audit
NDR_AUDIT_REGION=us-east-1
NDR_AUDIT_OBJECT_LOCK_MODE=COMPLIANCE
NDR_AUDIT_OBJECT_STORAGE_REQUIRED=false
NDR_EVIDENCE_BUCKET=
NDR_EVIDENCE_PREFIX=signalprism/evidence-packages
NDR_EVIDENCE_REGION=us-east-1
NDR_EVIDENCE_RETENTION_DAYS=90
NDR_EVIDENCE_OBJECT_LOCK_MODE=GOVERNANCE
NDR_EVIDENCE_STAGING_BUCKET=
NDR_EVIDENCE_SCAN_REQUIRED=false
NDR_EVIDENCE_STORAGE_REQUIRED=false
NDR_EVIDENCE_CHECKSUM_REQUIRED=false
NDR_EVIDENCE_SCAN_ATTESTATION_REQUIRED=false
NDR_EVIDENCE_SCANNER_SUBJECTS=
NDR_MAX_EVIDENCE_UPLOAD_BYTES=1073741824
NDR_MAX_ACTIVE_EVIDENCE_UPLOADS=20
NDR_MAX_TENANT_EVIDENCE_RESERVED_BYTES=21474836480
NDR_DIRECT_UPLOAD_TTL_SECONDS=900
NDR_PACKET_ALLOWED_BUCKETS=
NDR_PACKET_ALLOWED_PREFIXES=signalprism/evidence-packages
NDR_PACKET_OBJECT_VERIFICATION_REQUIRED=false

# Continuous OCSF delivery. Native current and Security Lake use distinct schema profiles.
NDR_FIREHOSE_STREAM_NAME=
NDR_FIREHOSE_NETWORK_STREAM_NAME=
NDR_FIREHOSE_FINDING_STREAM_NAME=
NDR_FIREHOSE_REGION=us-east-1
NDR_CONTINUOUS_STREAM_MODE=local
NDR_KINESIS_STREAM_NAME=
NDR_MSK_CLUSTER_ARN=
NDR_STREAM_DELIVERY_MAX_ATTEMPTS=12
NDR_STREAM_RETRY_INTERVAL_SECONDS=30
NDR_STREAM_RETRY_BATCH_SIZE=50
NDR_HOT_SEARCH_MODE=local
NDR_HOT_SEARCH_ENDPOINT=
NDR_SECURITY_LAKE_ASSIGNED_PREFIX=
NDR_SECURITY_LAKE_PROVIDER_ACCOUNT_ID=
NDR_SECURITY_LAKE_PROVIDER_EXTERNAL_ID=
NDR_RESPONSE_KILL_SWITCH=false
NDR_PLATFORM_KMS_KEY_ARN=
NDR_TENANT_BYOK_KEY_ARN=
NDR_AIR_GAPPED=false

# AWS Organizations and member-account ingest
NDR_ORGANIZATION_DISCOVERY_ENABLED=false
NDR_ORGANIZATION_REGION=us-east-1
NDR_ORGANIZATION_MEMBER_ROLE_NAME=SignalPrismReadOnlyRole
NDR_ORGANIZATION_EXTERNAL_ID=

# Persistence
# local keeps tenant metadata, jobs, runs, audit, and local evidence packages under NDR_DATA_DIR.
# dynamodb stores tenant metadata, jobs, runs, and audit records in the configured table.
NDR_STORE=local
NDR_DDB_TABLE=
NDR_DDB_REGION=us-east-1
NDR_DDB_GSI_MIGRATION_MODE=dual-read
NDR_MAX_TELEMETRY_EVENTS_PER_DAY=1000000
NDR_TELEMETRY_RETENTION_DAYS=30

# OIDC/SSO
NDR_OIDC_ISSUER=
NDR_OIDC_AUDIENCE=
NDR_OIDC_JWKS_URI=
NDR_OIDC_CLIENT_ID=
NDR_OIDC_CLIENT_SECRET=
NDR_OIDC_REDIRECT_URI=http://localhost:4173/
NDR_OIDC_SCOPES=openid profile email groups
NDR_REQUIRE_OIDC_TENANT_CLAIM=true
NDR_OIDC_CLOCK_SKEW_SECONDS=60
# Optional provider-specific claim such as access or id.
NDR_OIDC_TOKEN_USE=
NDR_TENANT_DIRECTORY_REQUIRED=false
# Development migration aid only. Production always uses issuer/subject binding.
NDR_ALLOW_DIRECTORY_EMAIL_MATCH=false
NDR_ADMIN_GROUP=ndr-admin
NDR_ANALYST_GROUP=ndr-analyst
NDR_VIEWER_GROUP=ndr-viewer
NDR_DEFAULT_TENANT=default
NDR_TENANT_CLAIM=tenant_id

# SCIM and non-human identities. Store production values in Secrets Manager.
NDR_SCIM_BEARER_TOKEN=
NDR_SCIM_TENANT_ID=default
NDR_SERVICE_ACCOUNT_PEPPER=

# Test-only identity injection. The server refuses this in NODE_ENV=production
# and refuses non-loopback binds whenever it is enabled.
NDR_TEST_AUTH_ENABLED=false

# AWS Bedrock AI assistant
NDR_BEDROCK_ENABLED=false
NDR_BEDROCK_REGION=us-east-1
NDR_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
NDR_BEDROCK_MAX_TOKENS=900
NDR_BEDROCK_TEMPERATURE=0.2
NDR_BEDROCK_MAX_CONTEXT_CHARS=24000
NDR_MAX_AI_AGENT_RUNS_PER_DAY=100
NDR_MAX_BEDROCK_CALLS_PER_DAY=250
NDR_MAX_BEDROCK_RESERVED_TOKENS_PER_DAY=250000
NDR_DETECTION_BACKTEST_MAX_AGE_DAYS=30

# AWS ingest credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
